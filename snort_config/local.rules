# $Id: local.rules,v 1.11 2004/07/23 20:15:44 bmc Exp $
# ----------------
# LOCAL RULES
# ----------------
# This file intentionally does not come with signatures.  Put your local
# additions here.
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force - Connexions rapides"; \
  flow:to_server; flags:S; \
  threshold:type both, track by_src, count 10, seconds 30; \
  classtype:attempted-admin; sid:9000001; rev:1;)

# ----------------
# HEARTBLEED (CVE-2014-0160) — SIDs 30514-30517
# Détection réponse serveur (large heartbeat = fuite mémoire)
# ----------------
alert tcp any 444 -> any any (msg:"SERVER-OTHER SSLv3 large heartbeat response - possible ssl heartbleed attempt"; flow:to_client,established; content:"|18 03 00|"; depth:3; byte_test:2,>,128,0,relative; detection_filter:track by_dst,count 3,seconds 60; reference:cve,2014-0160; classtype:attempted-recon; sid:30514; rev:3;)

alert tcp any 444 -> any any (msg:"SERVER-OTHER TLSv1 large heartbeat response - possible ssl heartbleed attempt"; flow:to_client,established; content:"|18 03 01|"; depth:3; byte_test:2,>,128,0,relative; detection_filter:track by_dst,count 3,seconds 60; reference:cve,2014-0160; classtype:attempted-recon; sid:30515; rev:3;)

alert tcp any 444 -> any any (msg:"SERVER-OTHER TLSv1.1 large heartbeat response - possible ssl heartbleed attempt"; flow:to_client,established; content:"|18 03 02|"; depth:3; byte_test:2,>,128,0,relative; detection_filter:track by_dst,count 3,seconds 60; reference:cve,2014-0160; classtype:attempted-recon; sid:30516; rev:3;)

alert tcp any 444 -> any any (msg:"SERVER-OTHER TLSv1.2 large heartbeat response - possible ssl heartbleed attempt"; flow:to_client,established; content:"|18 03 03|"; depth:3; byte_test:2,>,128,0,relative; detection_filter:track by_dst,count 3,seconds 60; reference:cve,2014-0160; classtype:attempted-recon; sid:30517; rev:3;)

# Détection requête malformée (client → serveur)
alert tcp any any -> any 444 (msg:"CLIENT SSL HEARTBLEED heartbeat request malformed"; flow:to_server,established; content:"|18 03|"; depth:2; content:"|01|"; distance:3; within:1; detection_filter:track by_src,count 3,seconds 60; reference:cve,2014-0160; classtype:attempted-recon; sid:9000002; rev:1;)
